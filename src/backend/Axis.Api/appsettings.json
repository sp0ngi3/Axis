{
  "SeedData": false,
  "ConnectionStrings": {
    "Axis": "Data Source=data/axis.db"
  },
  "Backup": {
    "Directory": "backups",
    "Daily": {
      "Enabled": false,
      "RetentionCount": 3,
      "RunAtLocalTime": "03:00",
      "TimeZoneId": "Europe/Berlin"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3001",
      "http://localhost:5174"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
