<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Axis-Setup</AssemblyName>
    <RootNamespace>Axis.Installer</RootNamespace>
    <ApplicationIcon>..\Axis.Launcher\axis-icon.ico</ApplicationIcon>
    <AxisPayload Condition="'$(AxisPayload)' == ''">..\..\artifacts\desktop\axis-desktop-payload.zip</AxisPayload>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(AxisPayload)')">
    <EmbeddedResource Include="$(AxisPayload)" LogicalName="Axis.Desktop.Payload.zip" />
  </ItemGroup>

</Project>
